# Copy this file to .env. Sign-in is done by hand in a browser window
# (run `python -m deepseek.auth`), so no credentials are stored here.

# --- Session ---
# DEEPSEEK_PROFILE_DIR=session/profile   # reuse an existing signed-in Chrome profile
# SESSION_PREWARM=1                      # validate/refresh the session at startup
# SERVER_INTERACTIVE_LOGIN=0             # never pop a browser mid-request (recommended)

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_EXEMPT_LOCALHOST=1          # coding agents fire many requests from loopback

# --- Agent bridge ---
# UPSTREAM_SERIALIZE=1                   # one upstream generation at a time (single account)
# THREAD_TTL_HOURS=12                    # how long a resumable DeepSeek thread is kept
# MAX_TOOL_RESULT_CHARS=16000            # condense big tool outputs (index + head + tail)
# APPEND_SOURCES=1                       # append a "Fuentes" list when web search runs
# DEFAULT_CONTEXT=800000
# DEFAULT_OUTPUT=32768

